# 构建产物
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# 平台生成物
windows/flutter/ephemeral/
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/

# ── 签名密钥，永远不进仓库 ──
#
# android/.gitignore 里也有这几条，这里是第二道。**重复不是冗余**：
# 那道防的是「在 android/ 下随手放一个」，这道防的是「在根目录下放」。
# 签名密钥泄漏 = 任何人都能签出和你一模一样的包，而安卓分不出来。
*.jks
*.keystore
key.properties

# flutter pub get 生成的插件清单。**每次 pub get 都会重写**，
# 里面列的插件取决于当前 lock 文件，提交它等于给每个改依赖的人
# 制造一次无意义的冲突。
windows/flutter/generated_plugins.cmake
windows/flutter/generated_plugin_registrant.cc
windows/flutter/generated_plugin_registrant.h
